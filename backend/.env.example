MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=shupick_v2
API_HOST=0.0.0.0
API_PORT=8000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=C:\secure\shupick-firebase-service-account.json
OUTBOX_WORKER_SECRET=replace-with-a-long-random-secret

# Numeric Kakao application ID (not a native/REST API key).
KAKAO_APP_ID=0
# NAVER Client Secret stays on this server, never in the Flutter app.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Must exactly match the callback registered with NAVER.
NAVER_REDIRECT_URI=http://10.0.2.2:8000/auth/social/naver/callback
